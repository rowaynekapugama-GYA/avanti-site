# Avanti website: server settings (Vercel > Settings > Environment Variables).
# This file is a list of names with example values only. Never put real keys in it, and never
# commit a real .env file. The repo is public.

# ---- site and database ----
SITE_URL=https://avantiprint.com.au
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=server-only-never-in-index-html

# ---- payments ----
STRIPE_SECRET_KEY=rk_live_xxx            # restricted key, Checkout Sessions: Write only
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_WEBHOOK_ID=xxx
PAYPAL_ENV=live                          # sandbox while testing
# PAYMENTS_SIMULATOR=true                # test gateway for staging only. Never set on the live site.

# ---- email (Resend) ----
RESEND_API_KEY=re_xxx                    # leave empty and emails are logged in the dashboard, not sent
RESEND_WEBHOOK_SECRET=whsec_xxx
EMAIL_FROM=Avanti Print & Design <no-reply@avantiprint.com.au>
EMAIL_REPLY_TO=info@avantiprint.com.au
BUSINESS_ABN=00 000 000 000
BUSINESS_ADDRESS=Street, Suburb NSW 0000

# ---- order emails (added 28 October 2026) ----
ORDER_EMAILS_ENABLED=true                # false = no order emails to customers or staff (orders still work)
ADMIN_NOTIFICATION_EMAIL=info@avantiprint.com.au   # gets a "New order" email for every paid order; "off" to stop
# EMAIL_TEST_RECIPIENT=you@example.com   # testing only: every email goes to this address instead
BUSINESS_TIMEZONE=Australia/Sydney       # analytics and email dates use this timezone

# ---- scheduled job ----
CRON_SECRET=any-long-random-string
