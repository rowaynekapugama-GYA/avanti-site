# Avanti website: server settings (Vercel > Settings > Environment Variables).
# This file is a list of names with example values only. Never put real keys in it, and never
# commit a real .env file. The repo is public.

# ---- site and database ----
SITE_URL=https://avantiprint.com.au
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=server-only-never-in-index-html

# ---- payments ----
STRIPE_SECRET_KEY=rk_live_xxx            # restricted key, Checkout Sessions: Write only
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_WEBHOOK_ID=xxx
PAYPAL_ENV=live                          # sandbox while testing
# PAYMENTS_SIMULATOR=true                # test gateway for staging only. Never set on the live site.

# ---- email (SMTP2GO, or Resend) ----
SMTP2GO_API_KEY=api-xxx                  # SMTP2GO API key (send email permission); used first when set
RESEND_API_KEY=                          # optional instead of SMTP2GO; with neither key, emails are logged in the dashboard, not sent
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Avanti Print & Design <no-reply@avantiprint.com.au>
EMAIL_REPLY_TO=info@avantiprint.com.au
BUSINESS_ABN=00 000 000 000
BUSINESS_ADDRESS=Street, Suburb NSW 0000

# ---- order emails (added 28 October 2026) ----
ORDER_EMAILS_ENABLED=true                # false = no order emails to customers or staff (orders still work)
ADMIN_NOTIFICATION_EMAIL=info@avantiprint.com.au, rowayne@gyaclients.com   # order alerts and copies, each address separately; "off" to stop (default: these two)
# EMAIL_TEST_RECIPIENT=you@example.com   # testing only: every email goes to this address instead
BUSINESS_TIMEZONE=Australia/Sydney       # analytics and email dates use this timezone

# ---- scheduled job ----
CRON_SECRET=any-long-random-string

# ---- discount codes (added 10 November 2026) ----
# Shows the "Have a discount code?" box at checkout and lets the server apply codes.
# Leave false (or unset) until supabase/migrations/20261110120000_discount_codes.sql has been run.
# Set it in Vercel for Production and Preview, then redeploy for the change to take effect.
DISCOUNTS_ENABLED=false

# ---- refunds and tax invoices (added 20 November 2026) ----
# Refunds from the dashboard order page (Stripe Refunds API / PayPal capture refund). Uses the existing
# STRIPE_SECRET_KEY and PayPal credentials; a restricted Stripe key needs "Refunds: Write".
# Leave false (or unset) until supabase/migrations/20261120120000_refunds_invoices.sql has been run.
REFUNDS_ENABLED=false
# A tax invoice PDF emailed after every paid order, plus adjustment notes for refunds. Also needs the
# legal business name and ABN entered in Dashboard > Business details.
INVOICES_ENABLED=false
# Eyelets dropdown on corflute (standard and custom sizes). Off until true; also off until the eyelets SQL has run.
EYELETS_ENABLED=false
